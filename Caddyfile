{
	admin off
	auto_https off
}

:{$PORT:3000} {
	root * /srv/site

	# ---- the only door to the core -------------------------------------
	# A request reaches sing-box only when it is BOTH on the secret path
	# AND a real WebSocket upgrade. A plain GET on that path, a scanner
	# with a guessed path, or a typo all fall through to the decoy site
	# and get the very same 404 page as any other missing URL — so the
	# secret path cannot be told apart from a wrong one.
	@ws {
		path {$WS_PATH:/ray}
		header Upgrade websocket
		header Connection *Upgrade*
	}
	reverse_proxy @ws 127.0.0.1:10000

	# The private import page lives under /<UUID>; keep it out of search
	# indexes (header only — never list the path in robots.txt).
	@sub path /{$UUID} /{$UUID}/*
	header @sub X-Robots-Tag "noindex, nofollow"

	file_server
	encode gzip

	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Errors are rendered as site pages, not as reverse-proxy output.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
